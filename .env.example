BOT_TOKEN=123456:replace-with-token-from-BotFather
# Optional. Comma-separated Telegram user IDs. Empty = anyone who knows the bot can use it.
ALLOWED_USER_IDS=

# Official cloud Bot API accepts ~50 MB. Leave empty for that.
# For 200 MB–2 GB locally:
#   1. Fill TELEGRAM_API_ID / TELEGRAM_API_HASH from https://my.telegram.org
#   2. docker compose -f docker-compose.api.yml up -d
#   3. Set TELEGRAM_API_URL=http://127.0.0.1:8081
TELEGRAM_API_URL=
MAX_FILE_MB=49

# From https://my.telegram.org — required for files larger than ~50 MB.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

LOG_LEVEL=INFO
# Empty = ./logs next to the project. In Docker this is /app/logs.
LOG_DIR=
